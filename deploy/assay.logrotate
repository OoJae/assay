# Install to /etc/logrotate.d/assay
#
# The units append to plain files with no rotation at all. agent.log and mcp.log grow without
# bound on a 3.7GB box with ~1GB available, and the failure mode -- a full disk -- takes down the
# paid endpoint and the MCP server together, with no signal beforehand.
/home/ubuntu/assay/agent.log
/home/ubuntu/assay/mcp.log
/home/ubuntu/assay/sweep.log {
    daily
    rotate 7
    maxsize 50M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    # ROOT, not ubuntu.
    #
    # The units write with systemd's `StandardOutput=append:`, which opens the file BEFORE dropping
    # to User=ubuntu -- so the logs are root:root 0644 even though the service runs as ubuntu.
    # `su ubuntu ubuntu` therefore could not truncate them: verified on the host, `logrotate -f`
    # exited 1 with "error opening ...: Permission denied" and rotated nothing. The rotation I
    # claimed to have added had never once run.
    #
    # It is stated explicitly rather than omitted because the parent directory is ubuntu-owned and
    # group-writable, and logrotate skips such files unless told whose privileges to use.
    su root root
}
