# Install to /etc/systemd/system/assay-sweep.timer, then:
#   sudo systemctl enable --now assay-sweep.timer
[Unit]
Description=Re-sweep Robinhood Chain every 8 minutes
Documentation=https://github.com/OoJae/assay

[Timer]
OnBootSec=5min
# MEASURED, not chosen by feel. Binary-searching the public RPC for the oldest block still serving
# state puts retention between 5,000 and 10,000 blocks at 0.101s per block -- so a citation stops
# being re-fetchable 8 to 17 minutes after it is minted. The previous 30min interval meant the
# published board spent most of its life carrying "reproduce this yourself" commands that had
# already expired. A full 195-asset sweep takes ~2.5 minutes on this host, so 8 minutes keeps the
# citations live at roughly a 30% duty cycle.
OnUnitActiveSec=8min
# Stagger, so 195 assets are not swept at the same second as every other timer on the box.
RandomizedDelaySec=45s
Persistent=true

[Install]
WantedBy=timers.target
